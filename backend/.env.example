KNOWAGENT_ENVIRONMENT=development
KNOWAGENT_DATABASE_URL=postgresql+psycopg://knowagent:change-me@127.0.0.1:5432/knowagent
KNOWAGENT_REDIS_URL=redis://127.0.0.1:6379/0
KNOWAGENT_REDIS_PREFIX=knowagent:dev
KNOWAGENT_SESSION_COOKIE=knowagent_session
KNOWAGENT_SESSION_TTL_SECONDS=28800
KNOWAGENT_COOKIE_SECURE=false
KNOWAGENT_LOGIN_ATTEMPTS=8
KNOWAGENT_LOGIN_WINDOW_SECONDS=900
KNOWAGENT_DOCUMENT_MAX_FILE_BYTES=26214400
KNOWAGENT_DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
KNOWAGENT_DOCUMENT_MAX_ARCHIVE_RATIO=100
KNOWAGENT_DOCUMENT_MAX_ARCHIVE_MEMBERS=10000
KNOWAGENT_DOCUMENT_MAX_PDF_PAGES=500
KNOWAGENT_DOCUMENT_MAX_PDF_BLOCKS=100000
KNOWAGENT_DOCUMENT_MAX_DOCX_BLOCKS=100000
KNOWAGENT_DOCUMENT_MAX_MARKDOWN_BLOCKS=100000
KNOWAGENT_DOCUMENT_MAX_XLSX_SHEETS=50
KNOWAGENT_DOCUMENT_MAX_XLSX_ROWS_PER_SHEET=100000
KNOWAGENT_DOCUMENT_MAX_XLSX_COLUMNS=256
KNOWAGENT_DOCUMENT_MAX_XLSX_CELLS=1000000
KNOWAGENT_DOCUMENT_CHUNK_MAX_TOKENS=512
KNOWAGENT_DOCUMENT_CHUNK_OVERLAP_BLOCKS=1
KNOWAGENT_S3_ENDPOINT_URL=https://object-storage.internal
KNOWAGENT_S3_BUCKET=knowagent-dev
KNOWAGENT_S3_REGION=us-east-1
KNOWAGENT_S3_ACCESS_KEY=change-me
KNOWAGENT_S3_SECRET_KEY=change-me
KNOWAGENT_S3_VERIFY_TLS=true
KNOWAGENT_S3_CA_BUNDLE=
KNOWAGENT_S3_MULTIPART_THRESHOLD=8388608
KNOWAGENT_S3_MULTIPART_CHUNK_SIZE=8388608
KNOWAGENT_S3_CONNECT_TIMEOUT_SECONDS=5
KNOWAGENT_S3_READ_TIMEOUT_SECONDS=60
KNOWAGENT_S3_SDK_MAX_ATTEMPTS=3
KNOWAGENT_INGESTION_MAX_ATTEMPTS=3
KNOWAGENT_INGESTION_LEASE_SECONDS=900
KNOWAGENT_INGESTION_RETRY_BASE_SECONDS=30
KNOWAGENT_INGESTION_DISPATCH_STALE_SECONDS=60
KNOWAGENT_INGESTION_RECOVERY_BATCH_SIZE=100
KNOWAGENT_INGESTION_SOFT_TIME_LIMIT_SECONDS=600
