KNOWAGENT_DOCUMENT_MAX_ARCHIVE_MEMBERS=10000
KNOWAGENT_DOCUMENT_MAX_PDF_PAGES=500
KNOWAGENT_DOCUMENT_MAX_PDF_BLOCKS=100000
KNOWAGENT_DOCUMENT_MAX_DOCX_BLOCKS=100000
KNOWAGENT_DOCUMENT_MAX_MARKDOWN_BLOCKS=100000
